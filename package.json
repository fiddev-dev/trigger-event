{
  "name": "scratch-uts-website",
  "version": "1.0.0",
  "private": true,
  "description": "Scratch projek 'Tugas Dasar Coding UTS (Lanjutan)' sebagai website statis client-side untuk GitHub Pages",
  "scripts": {
    "build": "node build.js",
    "dev": "node -e \"require('esbuild').build({entryPoints:['src/main.js'],bundle:true,outfile:'site/runtime.js',format:'iife',target:'es2018',platform:'browser',sourcemap:true,watch:true,define:{'process.env.NODE_ENV':'\\\"development\\\"'}}).catch(()=>process.exit(1))\"",
    "start": "python -m http.server 8099 -d site"
  },
  "dependencies": {
    "events": "^3.3.0",
    "scratch-render": "^2.2.84",
    "scratch-storage": "^6.2.1",
    "scratch-vm": "^5.0.299"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
